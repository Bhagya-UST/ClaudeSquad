FROM python:3.11-slim

WORKDIR /app

# Install system dependencies in single layer (faster caching)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables once
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_INPUT=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Upgrade pip (faster)
RUN pip install --no-cache-dir --quiet pip setuptools wheel

# Copy requirements and install (before app code for better caching)
COPY requirements.txt .
RUN pip install --no-cache-dir --retries 5 --default-timeout 100 \
    --trusted-host pypi.org --trusted-host files.pythonhosted.org \
    -r requirements.txt

# Copy application
COPY backend/ /app/backend/

# Expose port
EXPOSE 8000

# Run application
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
